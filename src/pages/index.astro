  ↑
</button>

<script is:inline>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  menuBtn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });

  const revealElements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("reveal-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.12
    }
  );

  revealElements.forEach((el) => {
    observer.observe(el);
  });

  const topBtn = document.getElementById("scrollToTop");

  window.addEventListener("scroll", () => {
    const visible = window.scrollY > 500;

    topBtn?.classList.toggle("opacity-0", !visible);
    topBtn?.classList.toggle("translate-y-4", !visible);
    topBtn?.classList.toggle("pointer-events-none", !visible);

    topBtn?.classList.toggle("opacity-100", visible);
    topBtn?.classList.toggle("translate-y-0", visible);
    topBtn?.classList.toggle("pointer-events-auto", visible);
  });

  topBtn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });

  const initiatives = {
    sep: {
      badge: "12-week incubation programme",
      title: "Social Entrepreneurship Programme",
      body: `
        <p>The Social Entrepreneurship Programme is designed to build a strong and enabling ecosystem for social enterprises in Kerala.</p>
        <p>The programme provides entrepreneurship development programmes, mentorship, expert sessions, market access and opportunities for funding and partnerships.</p>
        <p>The objective is to enable purpose-driven entrepreneurs to build sustainable and scalable solutions while positioning Kerala as a destination for high-impact social enterprises.</p>
      `
    },

    women: {
      badge: "First in Kerala",
      title: "Women Startup Cell",
      body: `
        <p>Kerala's first Women Startup Cell will provide a single access point for women entrepreneurs seeking startup support and information.</p>
        <p>The cell will connect women entrepreneurs with KSUM schemes, mentorship, incubation, co-working infrastructure, laboratories and other ecosystem opportunities.</p>
      `
    },

    literacy: {
      badge: "Grassroots outreach",
      title: "Startup Literacy Campaign",
      body: `
        <p>The Startup Literacy Campaign will take startup awareness and entrepreneurial knowledge into Tier 2 and Tier 3 regions across Kerala.</p>
        <p>Delivered with a strong Malayalam outreach component, the initiative will help aspiring entrepreneurs understand startup opportunities, support systems and pathways available to them.</p>
      `
    }
  };

  const modal = document.getElementById("initiative-modal");
  const modalDialog = document.getElementById("initiative-modal-dialog");
  const modalBadge = document.getElementById("initiative-modal-badge");
  const modalTitle = document.getElementById("initiative-modal-title");
  const modalBody = document.getElementById("initiative-modal-body");

  function openModal(key) {
    const content = initiatives[key];

    if (!content || !modal) return;

    if (modalBadge) modalBadge.textContent = content.badge;
    if (modalTitle) modalTitle.textContent = content.title;
    if (modalBody) modalBody.innerHTML = content.body;

    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    modalDialog?.focus();
  }

  function closeModal() {
    modal?.classList.remove("open");
    modal?.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";
  }

  document.querySelectorAll("[data-initiative-modal]").forEach((button) => {
    button.addEventListener("click", () => {
      openModal(button.getAttribute("data-initiative-modal"));
    });
  });

  document.querySelectorAll("[data-modal-close]").forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });
</script>
