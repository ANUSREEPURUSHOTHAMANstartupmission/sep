<script is:inline>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  menuBtn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });

  const revealElements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("reveal-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.12
    }
  );

  revealElements.forEach((el) => {
    observer.observe(el);
  });

  const topBtn = document.getElementById("scrollToTop");

  window.addEventListener("scroll", () => {
    const visible = window.scrollY > 500;

    topBtn?.classList.toggle("opacity-0", !visible);
    topBtn?.classList.toggle("translate-y-4", !visible);
    topBtn?.classList.toggle("pointer-events-none", !visible);

    topBtn?.classList.toggle("opacity-100", visible);
    topBtn?.classList.toggle("translate-y-0", visible);
    topBtn?.classList.toggle("pointer-events-auto", visible);
  });

  topBtn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });

  const initiatives = {
    sep: {
      badge: "12-week incubation programme",
      title: "Social Entrepreneurship Programme",
      body: `
        <p>Social Entrepreneurship Programme (SEP) is an initiative designed to build a strong and enabling ecosystem for social enterprises in Kerala. It supports purpose-driven entrepreneurs in transforming social and environmental challenges into innovative, sustainable and scalable solutions.</p>
        <p>SEP aims to position Kerala as a leading destination for social enterprises by enabling access to infrastructure, government support, funding, market opportunities, industry–academia linkages and other ecosystem resources. By connecting ideas with opportunities and purpose with scale, SEP will empower social enterprises to create lasting impact, strengthen communities and build home-grown global brands from Kerala.</p>
      `
    },

    women: {
      badge: "First in Kerala",
      title: "Women Startup Cell",
      body: `
        <p>A key highlight of the conclave will be the launch of Kerala's first Women Startup Cell and the Women Startup Handbook.</p>
        <p>The Women Startup Cell will serve as a single point of access for women entrepreneurs seeking information on startup support, KSUM schemes, mentorship, incubation and co-working spaces, labs, and other ecosystem resources.</p>
      `
    },

    literacy: {
      badge: "Grassroots outreach",
      title: "Startup Literacy Campaign",
      body: `
        <p>KSUM is expanding women-focused startup initiatives across Tier 2 and Tier 3 regions through Startup Literacy Campaigns in Malayalam.</p>
        <p>The conclave will mark the launch of the first edition of the Startup Literacy Campaign, bringing startup awareness, knowledge, and opportunities closer to aspiring entrepreneurs across Kerala.</p>
      `
    }
  };

  const modal = document.getElementById("initiative-modal");
  const modalDialog = document.getElementById("initiative-modal-dialog");
  const modalBadge = document.getElementById("initiative-modal-badge");
  const modalTitle = document.getElementById("initiative-modal-title");
  const modalBody = document.getElementById("initiative-modal-body");

  function openModal(key) {
    const content = initiatives[key];

    if (!content || !modal) return;

    if (modalBadge) modalBadge.textContent = content.badge;
    if (modalTitle) modalTitle.textContent = content.title;
    if (modalBody) modalBody.innerHTML = content.body;

    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    modalDialog?.focus();
  }

  function closeModal() {
    modal?.classList.remove("open");
    modal?.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";
  }

  document.querySelectorAll("[data-initiative-modal]").forEach((button) => {
    button.addEventListener("click", () => {
      openModal(button.getAttribute("data-initiative-modal"));
    });
  });

  document.querySelectorAll("[data-modal-close]").forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });
</script>
